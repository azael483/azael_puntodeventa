    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="/js/carrito.js"></script>
    <script src="/js/renderCarrito.js"></script>
    <script>
        $(document).ready(function () {
            renderCarrito(); // Llamar a renderCarrito al cargar la página
        });

        $(document).ready(function() {
            // Detectar el clic en la imagen (el enlace contiene la imagen)
            $('.producto').on('click', function(e) {
                e.preventDefault(); // Evitar que el enlace navegue a otra página

                // Obtener los datos del producto desde los atributos data-* del enlace
                const producto = {
                    Id: $(this).data('id'),           // Obtener el ID del producto
                    Nombre: $(this).data('nombre'),   // Obtener el nombre del producto
                    Precio: parseFloat($(this).data('precio')) // Obtener el precio y convertirlo a número
                };
                
                // Llamar a la función para agregar el producto al carrito
                agregarAlCarrito(producto);
            });
        });

        function mostrarToast(mensaje) {
            const toast = $('<div class="toast">' + mensaje + '</div>');
            $('body').append(toast);
            toast.fadeIn(300);
            setTimeout(() => {
                toast.fadeOut(300, () => {
                    toast.remove(); 
                });
            }, 2000);
        }

        $(document).ready(function() {
            // Detectar el clic en el botón de comprar
            $('#comprarBtn').on('click', function() {
                const carrito = obtenerCarrito(); // Obtener los productos del carrito
                if (carrito.length === 0) {
                    alert('Tu carrito está vacío.');
                } else {
                    // Aquí puedes agregar lógica para realizar la compra, como vaciar el carrito, mostrar un mensaje, etc.
                    alert('Gracias por tu compra!');
                    
                    // Vaciar el carrito
                    localStorage.removeItem('carrito'); // Eliminar carrito de localStorage
                    renderCarrito(); // Volver a renderizar el carrito (vacío)
                }
            });
        });

    </script>

