@{
    ViewData["Title"] = "Productos";
}
<h1>@ViewData["Title"]</h1>

<head>
    <style>
        .image-grid {
            width: 80%;
            display: flex;
            flex-wrap: wrap;
        }

        .image-item {
            width: 20%;
            padding: 5px;
            height: 160px;
        }

        img {
            width: 100%;
            height: 100%;
            border: 2px solid black;
            transition: transform 0.2s, border-color 0.2s;
        }

        .image-item:hover img {
            border-color: #007bff;
            transform: scale(1.05);
        }

        .sidebar {
            position: fixed;
            right: 0;
            top: 0;
            bottom: 0;
            width: 20%;
            background-color: #f8f9fa;
            padding: 20px;
            overflow-y: auto;
        }

        .toast {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background-color: #28a745;
            color: white;
            padding: 10px 20px;
            border-radius: 5px;
            display: none;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        }

        #comprarBtn {
            margin-top: 20px;
            font-size: 16px;
        }

    </style>
</head>

