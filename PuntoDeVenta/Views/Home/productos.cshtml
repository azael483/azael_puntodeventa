@{
    ViewData["Title"] = "Productos";
}
<h1>@ViewData["Title"]</h1>

<head>
    <style>
        .image-grid {
            display: flex;
            flex-wrap: wrap;
        }

        .image-item {
            width: 20%;
            padding: 10px;
            height: 170px;  
        }

        img {
            width: 100%;
            height: 100%;
            border: 2px solid black;
        }

        .sidebar {
            position: fixed;
            right: 0;
            top: 0;
            bottom: 0;
            width: 20%;
            background-color: #f8f9fa;
            padding: 20px;
            overflow-y: auto;
        }
    </style>
</head>

<body>
    <div class="image-grid">
    <div class="image-item">
        <a href="https://example.com/aceite"> <img src="~/images/aceite.png" alt="aceite">
        </a>
    </div>
    <div class="image-item">
        <a href="https://example.com/jabon"> <img src="~/images/jabon.png" alt="jabon">
        </a>
    </div>
    <div class="image-item">
        <a href="https://example.com/lechuga"> <img src="~/images/lechuga.png" alt="lechuga">
        </a>
    </div>
    <div class="image-item">
        <a href="https://example.com/tomate"> <img src="~/images/tomate.png" alt="tomate">
        </a>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8">
            </div>
        <div class="col-md-4 sidebar">
            <h2>Tu Carrito</h2>
            <ul id="carrito" class="list-group">
                </ul>
            <p>Total: $<span id="total">0.00</span></p>
        </div>
    </div>
</div>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        // Call the renderCarrito function after the DOM is loaded
        $(document).ready(function() {
            renderCarrito();
        });
    </script>
</body>


